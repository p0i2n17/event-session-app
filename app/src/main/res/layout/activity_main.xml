<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp"
    android:clipToPadding="false">

    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinner_filter"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/text_primary"
                android:theme="@style/ThemeOverlay.AppCompat.Dark"
                android:popupBackground="@color/bg_card" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="分享"
                android:textSize="13sp"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/accent_primary"
                style="@style/Widget.Material3.Button.TonalButton" />
        </LinearLayout>
    </RelativeLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/search_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/top_bar"
        android:layout_marginBottom="6dp"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/bg_input"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:hintEnabled="false"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="🔍 搜尋 IG 帳號或角色..."
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:paddingVertical="10dp"
            android:singleLine="true"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/search_layout"
        android:text="💡 點帳號開啟IG ∙ 長按帳號編輯 ∙ 左右滑切換天數"
        android:textColor="@color/text_hint"
        android:textSize="11sp"
        android:layout_marginBottom="6dp"/>

    <ListView
        android:id="@+id/list_cosers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tv_hint"
        android:layout_above="@id/bottom_bar"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay" />

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_manual_add"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="✏️ 手動"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            app:backgroundTint="@color/bg_button"
            android:textColor="@color/text_primary"
            app:cornerRadius="12dp"
            android:layout_marginEnd="6dp"
            app:iconPadding="0dp"
            style="@style/Widget.Material3.Button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scan"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="📷 掃描"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            app:backgroundTint="@color/bg_button"
            android:textColor="@color/text_primary"
            app:cornerRadius="12dp"
            android:layout_marginEnd="6dp"
            app:iconPadding="0dp"
            style="@style/Widget.Material3.Button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_gallery"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="🖼 圖庫"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            app:backgroundTint="@color/bg_button"
            android:textColor="@color/text_primary"
            app:cornerRadius="12dp"
            app:iconPadding="0dp"
            style="@style/Widget.Material3.Button" />
    </LinearLayout>
</RelativeLayout>